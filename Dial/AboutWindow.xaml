<Window x:Class="Dial.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AboutTitle}" Width="440" Height="376"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13" Icon="Assets/dial.ico" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <Window.Resources>
        <ResourceDictionary Source="Resources/Controls.xaml"/>
    </Window.Resources>
    <Grid Margin="24" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="64" Height="64" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="{DynamicResource AppName}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppName}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="DescriptionText" Text="{DynamicResource AboutDescription}" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource AboutAuthor}" Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Margin="0,16,0,0">
            <Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/abarlett368/dial"
                       Foreground="{DynamicResource AccentBrush}" RequestNavigate="ProjectLink_RequestNavigate">
                <Run Text="{DynamicResource ProjectOnGitHub}"/>
            </Hyperlink>
        </TextBlock>
        <TextBlock x:Name="LicenseText" Grid.Row="3" Margin="0,20,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource AboutLicense}"/>
        <Button x:Name="CloseButton" Grid.Row="4" Content="{DynamicResource Close}" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MinWidth="88" Height="28"
                Margin="0,24,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
