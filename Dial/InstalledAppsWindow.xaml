<Window x:Class="Dial.InstalledAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource InstalledAppsTitle}" Width="480" Height="520"
        MinWidth="360" MinHeight="320" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI" Icon="Assets/dial.ico" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Resources/Controls.xaml"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource InstalledAppsHint}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBox x:Name="SearchBox" Margin="0,0,0,12"
                     Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                     CaretBrush="{DynamicResource AppForegroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                     AutomationProperties.Name="{DynamicResource SearchApps}" TextChanged="SearchBox_TextChanged"/>
        </StackPanel>
        <ListBox x:Name="AppList" Grid.Row="1" DisplayMemberPath="Name" Padding="4"
                 Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                 BorderBrush="{DynamicResource ControlBorderBrush}" AutomationProperties.Name="{DynamicResource InstalledAppsTitle}"
                 SelectionChanged="AppList_SelectionChanged" MouseDoubleClick="AppList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="88" Padding="12,6"/>
            <Button x:Name="SelectButton" Content="{DynamicResource Select}" IsDefault="True" IsEnabled="False"
                    MinWidth="88" Padding="12,6" Margin="8,0,0,0" Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
