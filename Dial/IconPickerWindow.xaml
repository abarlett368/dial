<Window x:Class="Dial.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource IconPickerTitle}" Width="480" Height="500"
        MinWidth="360" MinHeight="320" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
        FontFamily="Segoe UI" Icon="Assets/dial.ico" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Resources/Controls.xaml"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource IconPickerHint}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SystemIconsButton" Content="{DynamicResource SystemIcons}" MinWidth="88"
                        Padding="12,6" Click="SystemIconsButton_Click"/>
                <Button x:Name="BrowseButton" Content="{DynamicResource Browse}" MinWidth="88"
                        Padding="12,6" Margin="8,0,0,0" Click="BrowseButton_Click"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="IconList" Grid.Row="1" Padding="4"
                 Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}"
                 BorderBrush="{DynamicResource ControlBorderBrush}"
                 AutomationProperties.Name="{DynamicResource IconPickerTitle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.CacheLength="0"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SizeChanged="IconList_SizeChanged"
                 PreviewKeyDown="IconList_PreviewKeyDown"
                 MouseDoubleClick="IconList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="72" Height="64" Padding="8,6" ToolTip="{Binding Name}"
                                        AutomationProperties.Name="{Binding Name}" Click="IconButton_Click"
                                        GotKeyboardFocus="IconButton_GotKeyboardFocus">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Width="56">
                                        <Grid Height="32">
                                            <Image Source="{Binding Image}" Width="28" Height="28" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" IsCancel="True" MinWidth="88" Padding="12,6"/>
                <Button x:Name="SelectButton" Content="{DynamicResource Select}" IsDefault="True" IsEnabled="False"
                        MinWidth="88" Padding="12,6" Margin="8,0,0,0" Click="SelectButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{DynamicResource LoadingIcons}"
                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
