<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dial</RootNamespace>
    <AssemblyName>dial</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\dial.ico</ApplicationIcon>
    <Version>1.4.9</Version>
    <Product>dial</Product>
    <Title>dial</Title>
    <Authors>abarlett368</Authors>
    <Copyright>Copyright (c) 2026 abarlett368</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Description>A radial app launcher for Windows</Description>
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\dial.ico" />
  </ItemGroup>

</Project>
