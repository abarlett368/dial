<Window x:Class="Dial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WindowTitle}"
        Width="920" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Icon="Assets/dial.ico"
        UseLayoutRounding="True"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Controls.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                CornerRadius="0" SnapsToDevicePixels="True"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background"
                                                        Value="{DynamicResource ControlHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background"
                                                        Value="{DynamicResource SelectionBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource AppForegroundBrush}"
                                  StrokeThickness="1.5" Fill="Transparent"
                                  Width="8" Height="5"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Margin="0,0,8,0" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="0">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FieldLabelBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FieldLabelBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderRow" Grid.Row="0" Margin="24,18,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource AppName}" FontSize="24" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Bottom" Margin="10,0,0,3"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="{DynamicResource SuccessTextBrush}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite"
                       ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="60000"
                       Margin="20,0,16,0" Visibility="Collapsed">
                <TextBlock.ToolTip>
                    <ToolTip x:Name="StatusToolTip">
                        <TextBlock Text="{Binding PlacementTarget.Text, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                   MaxWidth="480" TextWrapping="Wrap"/>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
            <Button x:Name="SaveButton" Grid.Column="2" VerticalAlignment="Center"
                    Content="{DynamicResource Save}" MinWidth="88" Height="32"
                    Style="{StaticResource AccentButton}" Click="SaveButton_Click"/>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPanel" Grid.Column="0" Margin="0,0,16,0"
                  Height="{Binding ActualHeight, ElementName=RightContent}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AddButton" Content="{DynamicResource Add}" Height="30"
                            Click="AddButton_Click"/>
                    <Button x:Name="RemoveButton" Grid.Column="1" Content="{DynamicResource Remove}" Height="30"
                            Padding="8,5" Margin="6,0,0,0" Click="RemoveButton_Click"/>
                    <Button x:Name="UpButton" Grid.Column="2" Content="↑" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                            AutomationProperties.Name="{DynamicResource MoveUp}" ToolTip="{DynamicResource MoveUp}" Click="UpButton_Click"/>
                    <Button x:Name="DownButton" Grid.Column="3" Content="↓" Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                            AutomationProperties.Name="{DynamicResource MoveDown}" ToolTip="{DynamicResource MoveDown}" Click="DownButton_Click"/>
                </Grid>
                <ListBox x:Name="ItemList" Grid.Row="1" AutomationProperties.Name="{DynamicResource Items}"
                         SelectionChanged="ItemList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Image Source="{Binding DisplayImage}" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayGlyph}"
                                               FontFamily="{Binding DisplayFontFamily}"
                                               FontSize="11" TextTrimming="CharacterEllipsis"
                                               MaxWidth="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" x:Name="RightContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                    <Border x:Name="GeneralCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource General}" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource HotkeyField}" Style="{StaticResource OptionLabel}"/>
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,4,0,4">
                                    <Button x:Name="RecordHotkeyButton" DockPanel.Dock="Right" Content="{DynamicResource RecordShortcut}"
                                            Padding="4,0" Width="48" Margin="8,0,0,0" Click="RecordHotkeyButton_Click"
                                            LostKeyboardFocus="ShortcutControl_LostKeyboardFocus"/>
                                    <TextBox x:Name="HotkeyBox" IsReadOnly="True" Padding="4,0"
                                             AutomationProperties.Name="{DynamicResource HotkeyField}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                             LostKeyboardFocus="ShortcutControl_LostKeyboardFocus"/>
                                </DockPanel>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource ThemeField}"
                                           Style="{StaticResource OptionLabel}" Margin="16,0,14,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="ThemeBox" Margin="0,4,0,4"
                                          AutomationProperties.Name="{DynamicResource ThemeField}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LanguageField}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguageBox" Margin="0,4,0,4"
                                          AutomationProperties.Name="{DynamicResource LanguageField}"/>

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource HoverColorField}"
                                           Style="{StaticResource OptionLabel}" Margin="16,0,14,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="HoverColorBox" Margin="0,4,0,4"
                                          AutomationProperties.Name="{DynamicResource HoverColorField}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource IconModeField}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="IconModeBox" Margin="0,4,0,4"
                                          AutomationProperties.Name="{DynamicResource IconModeField}"/>

                                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ShowAtMouseBox"
                                          Content="{DynamicResource ShowAtMouseField}" Margin="0,8,0,0"/>
                                <CheckBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" x:Name="ShowCenterBox"
                                          Content="{DynamicResource ShowCenterField}" Margin="16,8,0,0"/>
                                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" x:Name="StartupBox"
                                          Content="{DynamicResource Startup}" Margin="0,8,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ItemCard" Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LabelField}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="LabelBox" MaxLength="64" AutomationProperties.Name="{DynamicResource LabelField}"
                                     TextChanged="LabelBox_TextChanged"/>

                            <TextBlock Text="{DynamicResource TypeField}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TypeBox" AutomationProperties.Name="{DynamicResource TypeField}"
                                      SelectionChanged="TypeBox_SelectionChanged"/>

                            <TextBlock x:Name="TargetLabel" Text="{DynamicResource TargetField}" Style="{StaticResource FieldLabel}"/>
                            <DockPanel x:Name="TargetPanel">
                                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="{DynamicResource Browse}"
                                        MinWidth="80" Padding="8,0" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                                <Button x:Name="FolderBrowseButton" DockPanel.Dock="Right" Content="{DynamicResource BrowseFolder}"
                                        Margin="8,0,0,0" Padding="8,0" Click="FolderBrowseButton_Click"/>
                                <Button x:Name="InstalledAppsButton" DockPanel.Dock="Right" Content="{DynamicResource ChooseApp}"
                                        Margin="8,0,0,0" Padding="8,0" Click="InstalledAppsButton_Click"/>
                                <TextBox x:Name="TargetBox" AutomationProperties.LabeledBy="{Binding ElementName=TargetLabel}"
                                         TextChanged="TargetBox_TextChanged"/>
                            </DockPanel>

                            <TextBlock x:Name="ArgsLabel" Text="{DynamicResource ArgsField}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ArgsBox" AutomationProperties.Name="{DynamicResource ArgsField}"
                                     TextChanged="ArgsBox_TextChanged"/>
                            <CheckBox x:Name="AdministratorBox" Content="{DynamicResource RunAsAdministrator}"
                                      ToolTip="{DynamicResource AdministratorHint}" Margin="0,10,0,0"
                                      ToolTipService.ShowOnDisabled="True"
                                      Checked="AdministratorBox_Changed" Unchecked="AdministratorBox_Changed"/>
                            <TextBlock x:Name="ElevationHint" Text="{DynamicResource AppElevationNotSupported}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Visibility="Collapsed"/>

                            <TextBlock x:Name="CmdLabel" Text="{DynamicResource CommandField}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CommandBox" AutomationProperties.Name="{DynamicResource CommandField}"
                                      SelectionChanged="CommandBox_SelectionChanged"/>

                            <TextBlock x:Name="IconLabel" Text="{DynamicResource IconField}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="IconBox" AutomationProperties.Name="{DynamicResource IconField}"
                                     TextChanged="IconBox_TextChanged"/>

                            <CheckBox x:Name="EnabledBox" Content="{DynamicResource EnabledField}" Margin="0,10,0,0"
                                      Checked="EnabledBox_Changed" Unchecked="EnabledBox_Changed"/>
                        </StackPanel>
                    </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
